# ── Backend Credentials (from bin registration) ──
BIN_ID=paste_your_bin_id_here
BIN_API_KEY=paste_your_api_key_here
SERVER_URL=http://localhost:8000

# ── HX711 Load Cell ──
HX711_DT_PIN=5
HX711_SCK_PIN=6
CALIBRATION_FACTOR=420.0

# ── HC-SR04 Ultrasonic ──
TRIG_PIN=23
ECHO_PIN=24
BIN_DEPTH_CM=50

# ── SG90 Servo (trap door) ──
SERVO_PIN=17

# ── 28BYJ-48 Stepper (funnel rotation) ──
STEPPER_IN1=20
STEPPER_IN2=21
STEPPER_IN3=16
STEPPER_IN4=18

# ── Sensors ──
IR_PRESENCE_PIN=25
MOISTURE_PIN=7
METAL_PIN=12

# ── Status LEDs ──
LED_GREEN_PIN=13
LED_RED_PIN=19
LED_YELLOW_PIN=26
